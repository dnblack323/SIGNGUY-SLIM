SIGNGUY_SLIM_DB_PATH=./data/signguy-slim.sqlite
SIGNGUY_SLIM_ATTACHMENT_ROOT=./data/attachments
SIGNGUY_SLIM_SERVER_BACKUP_ROOT=./data/server-backups
SIGNGUY_SLIM_SERVER_BACKUP_RETAIN_LAST=30
SIGNGUY_SLIM_UPLOAD_LIMIT_BYTES=10485760
SIGNGUY_SLIM_DEFAULT_TENANT_STORAGE_QUOTA_BYTES=1073741824

# Commercial Release B onboarding/account controls.
# Production defaults to invite-only registration unless explicitly enabled.
SIGNGUY_SLIM_PUBLIC_REGISTRATION_ENABLED=0
SIGNGUY_SLIM_APP_URL=http://localhost:5173
SIGNGUY_SLIM_PASSWORD_RESET_LIFETIME_SECONDS=3600
SIGNGUY_SLIM_SIGNUP_INVITATION_LIFETIME_SECONDS=604800
SIGNGUY_SLIM_RATE_LIMIT_LOGIN_IP_LIMIT=20
SIGNGUY_SLIM_RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
SIGNGUY_SLIM_RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=8
SIGNGUY_SLIM_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
SIGNGUY_SLIM_RATE_LIMIT_REGISTER_IP_LIMIT=8
SIGNGUY_SLIM_RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_REQUEST_IP_LIMIT=10
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_REQUEST_IP_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_REQUEST_EMAIL_LIMIT=5
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_REQUEST_EMAIL_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_COMPLETE_IP_LIMIT=20
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_COMPLETE_IP_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_COMPLETE_TOKEN_LIMIT=8
SIGNGUY_SLIM_RATE_LIMIT_PASSWORD_RESET_COMPLETE_TOKEN_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_EMAIL_SEND_LIMIT=60
SIGNGUY_SLIM_RATE_LIMIT_EMAIL_SEND_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_UPLOAD_LIMIT=120
SIGNGUY_SLIM_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
SIGNGUY_SLIM_RATE_LIMIT_BACKUP_LIMIT=12
SIGNGUY_SLIM_RATE_LIMIT_BACKUP_WINDOW_SECONDS=3600

# Required for production HTTPS / split-origin deployments as applicable.
SIGNGUY_SLIM_COOKIE_SECURE=0
SIGNGUY_SLIM_TRUST_PROXY=0
SIGNGUY_SLIM_ALLOWED_ORIGINS=

# Optional customer communication and intake providers.
SIGNGUY_SLIM_SENDGRID_API_KEY=
SIGNGUY_SLIM_SENDGRID_WEBHOOK_SECRET=
SIGNGUY_SLIM_INTAKE_WEBHOOK_SECRET=
SIGNGUY_SLIM_INTAKE_DOMAIN=intake.signguy-slim.local

PORT=4175
